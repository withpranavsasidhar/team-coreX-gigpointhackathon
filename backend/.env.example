# Copy to .env and fill in. Never commit .env itself.

# ---------- Database ----------
DATABASE_URL=postgresql+psycopg://user@localhost:5433/aria

# ---------- A.R.I.A. conversational agent ----------
# Any OpenAI-compatible endpoint. Without these two, the agent is disabled and
# the app says so; it falls back to the deterministic rule engine, which is a
# real engine, not a simulation of AI.
AI_API_KEY=
AI_BASE_URL=https://openrouter.ai/api/v1
# Pick any model your provider offers, including a free one.
# Examples: deepseek/deepseek-chat-v3-0324:free, meta-llama/llama-3.3-70b-instruct:free
AI_MODEL=

# ---------- A.R.I.A. Vision (optional) ----------
# Reuses AI_API_KEY and AI_BASE_URL, but needs a model that can see.
# Without VISION_MODEL, Vision says it is unavailable rather than guessing.
# Examples: qwen/qwen2.5-vl-72b-instruct:free, google/gemini-2.0-flash-exp:free
VISION_MODEL=

# ---------- Legacy extraction provider (optional) ----------
ANTHROPIC_API_KEY=

# ---------- Translation (optional) ----------
# Language detection works locally without this. Translation is only used where
# it genuinely helps; it is never used to "understand" Telugu or Hindi, because
# the meaning is read directly.
TRANSLATION_PROVIDER=none
GOOGLE_TRANSLATE_API_KEY=
GOOGLE_TRANSLATE_PROJECT_ID=

# ---------- App ----------
CORS_ORIGINS=http://localhost:3000
